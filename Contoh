<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MEQ491 - Upload Foto</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background:
        radial-gradient(circle at top, #252525 0%, #0d0d0d 45%, #000 100%);
    color: white;
    min-height: 100vh;
}

.container {
    width: 92%;
    max-width: 600px;
    margin: auto;
    padding: 30px 0 50px;
}

.header {
    text-align: center;
    margin-bottom: 25px;
}

.logo {
    font-size: 42px;
    font-weight: bold;
    letter-spacing: 3px;
}

.subtitle {
    color: #aaa;
    margin-top: 8px;
}

.upload-box {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 20px;
    padding: 25px;
    text-align: center;
    box-shadow: 0 10px 35px rgba(0,0,0,0.4);
}

.upload-icon {
    font-size: 55px;
    margin-bottom: 10px;
}

input[type="file"] {
    display: none;
}

.choose-btn {
    display: inline-block;
    padding: 14px 25px;
    border-radius: 12px;
    background: #ffffff;
    color: #111;
    font-weight: bold;
    cursor: pointer;
    margin-top: 10px;
}

.preview {
    margin-top: 20px;
}

.preview img {
    width: 100%;
    max-height: 350px;
    object-fit: contain;
    border-radius: 15px;
    display: none;
}

.upload-btn {
    width: 100%;
    border: none;
    padding: 15px;
    margin-top: 15px;
    border-radius: 12px;
    background: #00c853;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    display: none;
}

.upload-btn:disabled {
    opacity: 0.5;
}

.status {
    margin-top: 15px;
    color: #bbb;
    font-size: 14px;
}

.gallery-title {
    margin-top: 35px;
    margin-bottom: 15px;
    font-size: 22px;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.photo {
    background: #151515;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
}

.photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.back-btn {
    display: block;
    text-align: center;
    margin-top: 30px;
    padding: 13px;
    border-radius: 12px;
    background: #222;
    color: white;
    text-decoration: none;
}
</style>
</head>

<body>

<div class="container">

    <div class="header">
        <div class="logo">MEQ491</div>
        <div class="subtitle">Upload & Galeri Foto</div>
    </div>

    <div class="upload-box">

        <div class="upload-icon">📷</div>

        <h2>Upload Foto</h2>

        <p>Pilih foto dari galeri HP kamu</p>

        <label for="photoInput" class="choose-btn">
            ＋ Pilih Foto
        </label>

        <input
            type="file"
            id="photoInput"
            accept="image/*"
        >

        <div class="preview">
            <img id="previewImage">
        </div>

        <button id="uploadBtn" class="upload-btn">
            ⬆ Upload Foto
        </button>

        <div id="status" class="status"></div>

    </div>

    <h2 class="gallery-title">📸 Galeri MEQ491</h2>

    <div id="gallery" class="gallery"></div>

    <a href="index.html" class="back-btn">
        ← Kembali
    </a>

</div>


<script>

/* =====================================================
   MASUKKAN DATA SUPABASE KAMU DI SINI
   ===================================================== */

const SUPABASE_URL = "MASUKKAN_SUPABASE_URL_DI_SINI";

const SUPABASE_ANON_KEY = "MASUKKAN_SUPABASE_ANON_KEY_DI_SINI";


/* =====================================================
   ELEMENT
   ===================================================== */

const photoInput = document.getElementById("photoInput");
const previewImage = document.getElementById("previewImage");
const uploadBtn = document.getElementById("uploadBtn");
const statusText = document.getElementById("status");
const gallery = document.getElementById("gallery");

let selectedFile = null;


/* =====================================================
   PILIH FOTO
   ===================================================== */

photoInput.addEventListener("change", function () {

    const file = this.files[0];

    if (!file) {
        return;
    }

    if (!file.type.startsWith("image/")) {
        statusText.textContent = "File harus berupa foto.";
        return;
    }

    if (file.size > 10 * 1024 * 1024) {
        statusText.textContent = "Ukuran foto maksimal 10 MB.";
        return;
    }

    selectedFile = file;

    const reader = new FileReader();

    reader.onload = function (event) {

        previewImage.src = event.target.result;
        previewImage.style.display = "block";

        uploadBtn.style.display = "block";

        statusText.textContent =
            "Foto siap di-upload.";

    };

    reader.readAsDataURL(file);

});


/* =====================================================
   UPLOAD FOTO
   ===================================================== */

uploadBtn.addEventListener("click", async function () {

    if (!selectedFile) {
        return;
    }

    if (
        SUPABASE_URL.includes("MASUKKAN_") ||
        SUPABASE_ANON_KEY.includes("MASUKKAN_")
    ) {

        statusText.textContent =
            "Supabase belum diatur.";

        return;
    }

    uploadBtn.disabled = true;

    statusText.textContent =
        "Sedang meng-upload foto...";

    try {

        const fileName =
            Date.now() +
            "-" +
            Math.random().toString(36).substring(2) +
            "-" +
            selectedFile.name.replace(/\s+/g, "-");

        const uploadURL =
            SUPABASE_URL +
            "/storage/v1/object/foto/" +
            fileName;

        const response = await fetch(uploadURL, {

            method: "POST",

            headers: {
                "apikey": SUPABASE_ANON_KEY,
                "Authorization":
                    "Bearer " + SUPABASE_ANON_KEY,
                "Content-Type":
                    selectedFile.type,
                "x-upsert": "false"
            },

            body: selectedFile

        });


        if (!response.ok) {

            const errorText =
                await response.text();

            throw new Error(errorText);

        }


        statusText.textContent =
            "✅ Foto berhasil di-upload!";


        selectedFile = null;

        photoInput.value = "";

        previewImage.style.display = "none";

        uploadBtn.style.display = "none";


        loadGallery();

    }

    catch (error) {

        console.error(error);

        statusText.textContent =
            "❌ Upload gagal. Periksa pengaturan Supabase.";

    }

    uploadBtn.disabled = false;

});


/* =====================================================
   TAMPILKAN GALERI
   ===================================================== */

async function loadGallery() {

    if (
        SUPABASE_URL.includes("MASUKKAN_") ||
        SUPABASE_ANON_KEY.includes("MASUKKAN_")
    ) {
        return;
    }


    try {

        const response = await fetch(

            SUPABASE_URL +
            "/storage/v1/object/list/foto",

            {

                method: "POST",

                headers: {

                    "apikey":
                        SUPABASE_ANON_KEY,

                    "Authorization":
                        "Bearer " +
                        SUPABASE_ANON_KEY,

                    "Content-Type":
                        "application/json"

                },

                body: JSON.stringify({

                    limit: 100,

                    offset: 0,

                    sortBy: {

                        column: "created_at",

                        order: "desc"

                    }

                })

            }

        );


        if (!response.ok) {

            throw new Error(
                "Gagal mengambil galeri"
            );

        }


        const files =
            await response.json();


        gallery.innerHTML = "";


        files.forEach(file => {

            if (!file.name) {
                return;
            }


            const imageURL =
                SUPABASE_URL +
                "/storage/v1/object/public/foto/" +
                encodeURIComponent(file.name);


            const div =
                document.createElement("div");

            div.className = "photo";


            const img =
                document.createElement("img");

            img.src = imageURL;

            img.loading = "lazy";


            div.appendChild(img);

            gallery.appendChild(div);

        });


    }

    catch (error) {

        console.error(error);

        gallery.innerHTML =
            "<p>Galeri belum tersedia.</p>";

    }

}


/* =====================================================
   JALANKAN GALERI
   ===================================================== */

loadGallery();

</script>

</body>
</html>
